# Copy to .env for local development. NEVER commit .env or real values.
# Placeholder names only. Task 002 needs no provider credentials: development
# and CI run on sample data only.

# Log level for routesmart loggers: DEBUG, INFO, WARNING, ERROR, CRITICAL.
ROUTESMART_LOG_LEVEL=INFO

# Test-only opt-in for tests marked `live` (real provider calls). Leave unset.
# Setting it to 1 requires explicit owner approval (CLAUDE.md §9, §11).
# ROUTESMART_ALLOW_LIVE=

# --- Future candidate providers (NOT approved for live use; leave unset) ---
# Each needs feasibility verification and owner approval first.
# See docs/PROVIDER_FEASIBILITY.md and DECISIONS.md.
# SERPAPI_API_KEY=
# AERODATABOX_RAPIDAPI_KEY=
# OPENWEATHERMAP_API_KEY=
# TOMORROW_IO_API_KEY=
# MAPPLS_API_KEY=
# TOLLGURU_API_KEY=

# --- Future Supabase settings (Phase 4; design auth/RLS first) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
